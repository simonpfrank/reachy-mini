# Development on Reachy. Setup saves these values in .env (excluded from Git).
# Normal dashboard startup keeps its existing /venvs/.env and live tools directory.
REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=/home/pollen/projects/reachy-tools/robot_tools
AUTOLOAD_EXTERNAL_TOOLS=0
REACHY_MINI_INSTANCE_PATH=/home/pollen/.local/share/reachy-tools-dev/conversation_app
REACHY_TOOLS_STATE_DIR=/home/pollen/.local/share/reachy-tools-dev/tools
REACHY_TOOLS_CONTROL_PORT=8787
HF_REALTIME_CONNECTION_MODE=local
HF_REALTIME_WS_URL=ws://127.0.0.1:8786/v1/realtime
REACHY_HOST=127.0.0.1

# User personalities are linked into the separate development instance.
REACHY_MINI_CUSTOM_PROFILE=user_personalities/Standard
