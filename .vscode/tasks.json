{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Reachy: maintained tests (tracker excluded)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pytest", "tests/unit", "--ignore=tests/unit/test_tracker.py", "-q"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "shared", "clear": true}
    },
    {
      "label": "Reachy: all unit tests (includes experimental tracker)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pytest", "tests/unit", "-q"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "shared", "clear": true}
    },
    {
      "label": "Reachy: check",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "reachy_workbench", "check"],
      "group": "test",
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "shared", "clear": true}
    },
    {
      "label": "Reachy: offline scenario",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "reachy_workbench", "demo"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "shared", "clear": true}
    },
    {
      "label": "Reachy: build checked artifact",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "reachy_workbench", "build"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "shared", "clear": true}
    }
  ]
}
