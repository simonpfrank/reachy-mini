{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Reachy: conversation app",
      "type": "debugpy",
      "request": "launch",
      "module": "reachy_mini_conversation_app.main",
      "args": [
        "--ui",
        "--debug"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Reachy: telemetry hub",
      "type": "debugpy",
      "request": "launch",
      "module": "reachy_hub",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
